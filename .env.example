# Copy this file to .env.local and fill in the values from your Supabase
# project (Dashboard → Settings → API). The anon key is safe to expose in
# the browser bundle — access is enforced by the RLS policies in
# supabase/schema.sql, not by keeping this key secret.
#
# Never put the Postgres database password or the service_role key here —
# neither belongs in a client-side app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
